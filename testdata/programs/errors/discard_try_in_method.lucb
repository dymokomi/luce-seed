import strings

pub let syntax: ErrorCode = ErrorCode.package(1)
struct P:
    var offset: usize
    var scratch: u8[]
    func fail(what: str) -> i64*!:
        let message = try strings.format(self.scratch, f"{what} at byte {self.offset}")
        error(syntax, message)
    func expect(ok: bool) -> !:
        if not ok:
            _ = try self.fail("expected")
        self.offset += 1
    func parse() -> i64!:
        try self.expect(true)
        try self.expect(false)
        return 1
pub func answer() -> i64:
    var scratch: u8[64]
    var p = P(offset = 0, scratch = scratch)
    let r = p.parse() catch failure:
        if failure.message == "expected at byte 1":
            recover 40
        recover 2
    return r
