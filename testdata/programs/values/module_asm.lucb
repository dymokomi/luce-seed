## A module-level `asm` block places raw assembly at file scope (base.md §8.9): a symbol
## defined there is called through an `extern` declaration. The symbol is defined under
## both spellings, with the C underscore of Mach-O and without it for ELF, so one block
## serves every operating system of its architecture.
# oracle: none
asm arm64:
    .globl _from_asm
    .globl from_asm
    .p2align 2
    _from_asm:
    from_asm:
        mov x0, #42
        ret

asm x86_64:
    .globl _from_asm
    .globl from_asm
    .p2align 4
    _from_asm:
    from_asm:
        movq $42, %rax
        ret

extern func from_asm() -> i64

pub func answer() -> i64:
    return from_asm()
# answer: 42
