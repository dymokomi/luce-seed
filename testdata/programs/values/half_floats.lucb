# answer: 40
## `f16` is a real binary16 (§5.1): two bytes in memory, every result rounded to half
## precision, converted to and from the other floats and the integers.
struct Sample:
    var value: f16
    var weight: f16

pub func answer() -> i64:
    let big: f16 = 2048.0
    let next = big + 1.0
    let third: f16 = 1.0 / 3.0
    let widened = f64(third) * 3.0
    let s = Sample(value = f16(0.1), weight = f16(0.2))
    let back = s.value + s.weight
    var total: i64 = i64(next) - 2048
    if widened < 1.0 and widened > 0.999:
        total += 20
    if f32(back) > 0.29 and f32(back) < 0.31:
        total += 20
    if sizeof(Sample) == 4:
        total += 0
    else:
        total += 1
    return total
