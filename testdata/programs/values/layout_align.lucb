import memory

## `packed` removes padding, `align(N)` raises a struct's or a field's alignment
## (base.md §5.11); both backends agree with C.
packed struct Wire:
    var tag: u8
    var value: u32

align(16) struct Vec:
    var x: f32
    var y: f32

struct Spaced:
    var a: u8
    align(8) var b: u8

pub func answer() -> i64:
    # 5 + 1 + 16 + 16 + 16 = 54
    return (i64)memory.size_of(Wire) + (i64)memory.offset_of(Wire, value) + (i64)memory.size_of(Vec) + (i64)memory.align_of(Vec) + (i64)memory.size_of(Spaced) - 12
# answer: 42
