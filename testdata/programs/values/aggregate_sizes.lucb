# answer: 88
## `sizeof` of a tuple, an optional, and a fallible result follows C's layout, tail padding
## included (§5.7, §5.8, §5.11): what the interpreter answers is what the C compiler lays out.
pub func answer() -> i64:
    let pair: (i64, u8) = (1, 2)
    let opt: i64? = 3
    let byte_opt: u8? = 4
    let wide: (u8, i64) = (5, 6)
    var total: i64 = 0
    total += i64(sizeof(pair)) + i64(sizeof(opt)) + i64(sizeof(byte_opt)) + i64(sizeof(wide))
    total += i64(alignof((i64, u8))) + i64(alignof(u8?))
    total += i64(sizeof(i64!)) + i64(sizeof(unit!))
    return total - 16 - 16 - 2 - 16 - 8 - 1 - 40 - 32 + 88
