# `c.str` is a pointer to C text; the C cast moves it to and from object pointers,
# which is how an argument vector for `execvp` is built.
import c

extern func strlen(text: c.str) -> usize

pub func answer() -> i64:
    let text: c.str = "hello"
    let raw = (void*)text
    let back = (c.str)raw
    var slots: void*?[2]
    slots[0] = (void*)text
    slots[1] = none
    var total: i64 = (i64)strlen(back)
    if slots[1] == none:
        total += 10
    if let first = slots[0]:
        total += (i64)strlen((c.str)first)
    return total
# answer: 20
