# args: a b

import luce_std.files
import io

pub func main(arguments: str[]) -> i32!:
    let out = io.stdout()
    for a in arguments[1..]:
        try out.write(f"arg {a}\n")
    let text = try files.read("/etc/hosts")
    defer text.release()
    try out.write(f"{text.value.length} bytes\n")
    return 0
