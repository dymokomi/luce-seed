func boom() -> i64!:
    error(3, "boom")
pub func main(arguments: str[]) -> i32!:
    let out = io.stdout()
    var backing: u8[256]
    var arena = FixedBuffer.over(backing)
    with arena:
        let p = try new i64
        *p = 5
        try out.write(f"p={*p}\n")
        let v = boom() catch failure:
            try out.write(f"caught {failure.message}\n")
            return 0
        try out.write(f"v={v}\n")
    return 0
