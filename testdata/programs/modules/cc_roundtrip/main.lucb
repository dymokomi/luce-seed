import c
import emit
import luce_std.files
import luce_std.process

pub func answer() -> i64!:
    var builder = try emit.Builder.create(8)
    defer builder.destroy()
    try builder.write(f"int main(void) {{ return 40; }}\n")
    try files.write("/tmp/lucb_seed_toy.c", builder.text())
    var args: c.str[3] = ["-o", "/tmp/lucb_seed_toy", "/tmp/lucb_seed_toy.c"]
    let compiled = try process.run("cc", args)
    defer compiled.release()
    if compiled.value.exit_code != 0:
        return i64(compiled.value.error_output.length) + 1
    var empty: c.str[1] = [""]
    let ran = try process.run("/tmp/lucb_seed_toy", empty[0..<0])
    defer ran.release()
    var cleanup: c.str[3] = ["-f", "/tmp/lucb_seed_toy", "/tmp/lucb_seed_toy.c"]
    let removed = try process.run("rm", cleanup)
    removed.release()
    return i64(ran.value.exit_code)
