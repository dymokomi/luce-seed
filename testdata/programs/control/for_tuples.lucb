## `for` binds a tuple of names to each element's components, whatever the sequence:
## `.indexed()` gives the index beside the element, and a span or array of tuples gives
## the tuple's own components (§8.3).
let rows: const (i64, i64, i64)[] = [(1, 2, 3), (4, 5, 6)]

pub func answer() -> i64:
    var total: i64 = 0
    for (a, b, c) in rows:
        total += a * b - c
    let pairs: (u8, i64)[2] = [(2, 3), (4, 5)]
    for (k, v) in pairs:
        for (i, x) in [k, k].indexed():
            total += i64(i) + i64(x) * v
    return total - 27
