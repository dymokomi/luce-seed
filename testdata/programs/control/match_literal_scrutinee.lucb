# An untyped integer literal as a `match` scrutinee takes the default `i64`.
pub func answer() -> i64:
    var score: i64 = 0
    match 3:
        1:
            score += 1
        3:
            score += 30
        _:
            score += 100
    match 2 + 5:
        7:
            score += 7
        _:
            score += 100
    return score
# answer: 37
