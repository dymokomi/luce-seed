# A triple-quoted literal drops its delimiters and the newline after the opening one,
# normalises line ends, and strips the indentation of its closing delimiter (base.md §4.4).
let flat: str = """
abc
def"""

func indented() -> str:
    let text = """
        one
          two
        """
    return text

pub func answer() -> i64:
    var score: i64 = 0
    if flat == "abc\ndef":
        score += 1
    if indented() == "one\n  two\n":
        score += 10
    if "tab\there".length == 8:
        score += 100
    return score
# answer: 111
