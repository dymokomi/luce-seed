# answer: 72
## A byte literal is static data of type `u8[N]` with `\xNN` escapes (§4.4): its length is
## its byte count and it is not NUL-terminated.
pub func answer() -> i64:
    let png = b"\x89PNG\r\n"
    var total: i64 = 0
    for b in png:
        total += i64(b)
    return i64(png.length) + i64(png[0]) - 137 + total - 359 + 42 - 6
