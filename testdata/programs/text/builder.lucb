# answer: 5

import memory
from io import Writer
from memory import Allocator

pub struct Builder implements Writer:
    var bytes: u8[]
    var length: usize
    var allocator: Allocator

    pub static func create(capacity: usize) -> Builder!:
        return Builder(bytes = try alloc u8[capacity], length = 0, allocator = memory.allocator)

    pub mutating func write(data: const u8[]) -> usize!:
        var room = self.bytes.length
        if room < self.length:
            error(memory.exhausted, "builder overflow")
        room = room - self.length
        if data.length > room:
            var cap = self.bytes.length
            if cap < 1:
                cap = 1
            while cap - self.length < data.length:
                let next = cap * 2
                if next <= cap:
                    error(memory.exhausted, "builder overflow")
                cap = next
            let grown = try alloc u8[cap] in self.allocator
            memory.copy(grown, self.bytes, self.length)
            free(self.bytes) in self.allocator
            self.bytes = grown
        memory.copy(self.bytes[self.length..], data, data.length)
        self.length = self.length + data.length
        return data.length

    pub func text() -> str:
        return (str)self.bytes[..<self.length]

    pub mutating func destroy():
        free(self.bytes) in self.allocator

pub func answer() -> i64!:
    var builder = try Builder.create(2)
    defer builder.destroy()
    try builder.write(f"n={40}")
    let w: Writer = &builder
    try w.write(f"!")
    return i64(builder.text().length)
