struct Entry:
    var key: i64
    var value: i64
    var used: bool

func lookup(table: Entry[], key: i64) -> i64?:
    var i: usize = 0
    while i < table.length:
        if table[i].used and table[i].key == key:
            return table[i].value
        i += 1
    return none

pub func answer() -> i64:
    var table: Entry[4]
    table[0] = Entry(key = 1, value = 10, used = true)
    table[1] = Entry(key = 2, value = 20, used = true)
    let a = lookup(table, 1) else 0
    let b = lookup(table, 2) else 0
    let c = lookup(table, 9) else 1
    return a + b + c
