# answer: 7

import c
import luce_std.process
import platform

pub func answer() -> i64!:
    var args: c.str[2] = ["/c", "<nul set /p=out& <nul set /p=err>&2& exit /b 7"] if platform.windows else ["-c", "printf out; printf err >&2; exit 7"]
    let ran = try process.run("cmd.exe" if platform.windows else "/bin/sh", args)
    defer ran.release()
    if ran.value.output == "out" and ran.value.error_output == "err":
        return i64(ran.value.exit_code)
    return 0
