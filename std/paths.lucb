## Lexical filesystem paths. Both slash styles separate components on Windows;
## on POSIX a backslash is an ordinary filename byte. No operation touches the disk.

import strings
import platform

pub func separator(byte: u8) -> bool:
    return byte == '/' or (platform.windows and byte == 92)

func last_separator(path: str) -> usize?:
    var index = path.length
    while index > 0:
        index -= 1
        if separator(path.bytes[index]):
            return index
    return none

func drive_prefix(path: str) -> bool:
    if not platform.windows or path.length < 2 or path.bytes[1] != ':':
        return false
    let drive = path.bytes[0]
    return (drive >= 'A' and drive <= 'Z') or (drive >= 'a' and drive <= 'z')

## The volume and root prefix, preserved verbatim. A drive-relative `C:foo` has
## root `C:`; a UNC share is indivisible, including its optional trailing separator.
pub func root(path: str) -> str:
    if drive_prefix(path):
        let count: usize = 3 if path.length > 2 and separator(path.bytes[2]) else 2
        return (str)path.bytes[..<count]
    if path.length == 0 or not separator(path.bytes[0]):
        return ""
    if not platform.windows or path.length < 2 or not separator(path.bytes[1]):
        return (str)path.bytes[..<1]
    var start: usize = 2
    # Extended DOS and UNC namespaces retain the prefix at the OS boundary.
    if path.length >= 4 and (path.bytes[2] == '?' or path.bytes[2] == '.') and separator(path.bytes[3]):
        start = 4
        if path.length >= 8 and ((str)path.bytes[4..<7] == "UNC" or (str)path.bytes[4..<7] == "unc") and separator(path.bytes[7]):
            start = 8
        else:
            while start < path.length and not separator(path.bytes[start]):
                start += 1
            return (str)path.bytes[..<(start + 1 if start < path.length else start)]
    # The server and share name together identify a UNC volume.
    var components: usize = 0
    while start < path.length:
        if separator(path.bytes[start]):
            components += 1
            if components == 2:
                return (str)path.bytes[..<start + 1]
        start += 1
    return path

## Rooted paths may still depend on the current drive (`\foo`) or that drive's
## current directory (`C:foo`). Only `is_absolute` promises independence from cwd.
pub func is_rooted(path: str) -> bool:
    return root(path).length > 0

pub func is_absolute(path: str) -> bool:
    if drive_prefix(path):
        return path.length >= 3 and separator(path.bytes[2])
    if path.length == 0 or not separator(path.bytes[0]):
        return false
    if not platform.windows:
        return true
    if path.length < 2 or not separator(path.bytes[1]):
        return false
    # Require a nonempty server and share (or a device namespace component).
    var index: usize = 2
    while index < path.length and not separator(path.bytes[index]):
        index += 1
    return index > 2 and index + 1 < path.length and not separator(path.bytes[index + 1])

## Everything up to the last separator, or `.` when there is none.
pub func directory(path: str) -> str:
    let prefix = root(path)
    let cut = last_separator(path) else return prefix if prefix.length > 0 else "."
    if cut < prefix.length:
        return prefix
    return (str)path.bytes[..<cut]

## The last component.
pub func base(path: str) -> str:
    let prefix = root(path)
    if prefix.length == path.length:
        return ""
    let cut = last_separator(path) else return (str)path.bytes[prefix.length..]
    return (str)path.bytes[cut + 1..]

## The extension with its dot, or the empty text.
pub func extension(path: str) -> str:
    let name = base(path)
    let dot = strings.last(name, '.') else return ""
    if dot == 0:
        return ""
    return (str)name.bytes[dot..]

## The last component without its extension.
pub func stem(path: str) -> str:
    let name = base(path)
    let ext = extension(name)
    return (str)name.bytes[..<name.length - ext.length]

## Join with a separator only when needed; an absolute right path wins. This is
## lexical joining, without normalization or filesystem access. The result is a
## NUL-terminated current-allocator allocation, released with strings.release.
pub func join(left: str, right: str) -> str!:
    if is_absolute(right) or drive_prefix(right) or left.length == 0:
        return try strings.copy(right)
    if platform.windows and is_rooted(right):
        let prefix = root(left)
        var end = prefix.length
        while end > 0 and separator(prefix.bytes[end - 1]):
            end -= 1
        let rooted_pieces: str[2] = [(str)prefix.bytes[..<end], right]
        return try strings.join(rooted_pieces, "")
    let drive_only = drive_prefix(left) and left.length == 2
    let delimiter = "" if separator(left.bytes[left.length - 1]) or drive_only else "/"
    let pieces: str[2] = [left, right]
    return try strings.join(pieces, delimiter)
