## Bootstrap subset of os: UTF-8 environment views, stable until the next call.
import c
import platform
extern func getenv(variable: c.str) -> const u8*?
extern func MultiByteToWideChar(page: u32, flags: u32, input: c.str, length: i32, output: u16*?, capacity: i32) -> i32
extern func WideCharToMultiByte(page: u32, flags: u32, input: const u16*, length: i32, output: u8*?, capacity: i32, fallback: void*?, used_fallback: void*?) -> i32
extern func GetEnvironmentVariableW(name: u16*, output: u16*, capacity: u32) -> u32
extern func GetLastError() -> u32
extern func SetLastError(error: u32)
extern func lb_rt_executable_path(buffer: u8*, capacity: usize) -> isize
local var executable_path: u8[4096]
pub let failed: ErrorCode = ErrorCode.package(12)
local var environment_wide: u16[32768]
local var environment_utf8: u8[131073]
local var environment_key: u16[32768]

pub func env(variable: c.str) -> str?:
    if not platform.windows:
        let value = getenv(variable) else return none
        return (str)(c.str)value
    if MultiByteToWideChar(65001, 8, variable, -1, &environment_key[0], 32768) == 0:
        return none
    SetLastError(0)
    let count = GetEnvironmentVariableW(&environment_key[0], &environment_wide[0], 32768)
    if count >= 32768 or (count == 0 and GetLastError() != 0):
        return none
    var size: i32 = 0
    if count > 0:
        size = WideCharToMultiByte(65001, 128, &environment_wide[0], (i32)count, &environment_utf8[0], 131072, none, none)
        if size == 0:
            return none
    environment_utf8[(usize)size] = 0
    return (str)environment_utf8[..<(usize)size]

## The path of this program's executable as the loader saw it, in storage stable until
## the next call.
pub func executable() -> str!:
    let count = lb_rt_executable_path(&executable_path[0], 4096)
    if count < 0:
        error(failed, "the executable path cannot be read")
    return (str)executable_path[..<(usize)count]
